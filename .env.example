# GaugeMarket — Environment Variables
# Copy this file to .env and fill in your values

# Flask session secret key — use a long random string in production
SECRET_KEY=your-secret-key-here

# Admin panel password
ADMIN_PASSWORD=admin1234

# Database paths (optional — defaults to project root)
FITTINGS_DB_PATH=fittings.db
VENDOR_DB_PATH=vendors.db

# QR output directories (optional — defaults to static/qrcodes)
QR_OUTPUT_DIR=static/qrcodes
VENDOR_QR_OUTPUT_DIR=static/vendor_qrcodes
VENDOR_GCODE_OUTPUT_DIR=static/vendor_gcode

# Public base URL used in QR codes (set to your deployed domain)
PUBLIC_BASE_URL=https://rail-qr-marketplace.vercel.app

# ESP32 engraver IP address (for hardware integration)
ESP32_IP=192.168.1.100

# AI risk model path (optional — regenerates automatically if missing)
RISK_MODEL_PATH=risk_model.pkl
